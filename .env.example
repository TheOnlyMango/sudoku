# Environment Configuration for SHNet Chat System
# Copy this file to .env and update with your values

# Encryption Secret (REQUIRED for secure communications)
# Generate a strong secret key - at least 32 characters
# Example: openssl rand -base64 32
CHAT_ENCRYPTION_SECRET=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION

# Optional: Override default server settings
# SERVER_HOST=0.0.0.0
# SERVER_PORT=7331

# Optional: Override default client settings
# CLIENT_SERVER=127.0.0.1
# CLIENT_PORT=7331

# Optional: Database paths (defaults to current directory)
# AUTH_DB_PATH=auth.db
# CHAT_DB_PATH=chat_messages.db
# OPERATIONS_DB_PATH=operations.db

# Optional: Logging configuration
# LOG_LEVEL=INFO
# LOG_DIR=logs
